{
  "name": "roundtable-bots",
  "version": "0.4.3",
  "description": "Named Bots and group conversations for DeepSeek Harness.",
  "icon": "./assets/roundtable-bots-icon-v2.png",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/roundtable-bots-icon-v2.png",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "MEMORY-DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-file-actions"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && DSH_BOTS_NATIVE_SMOKE=1 node scripts/smoke.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "smoke:native": "npm run smoke",
    "test:memory": "node --max-old-space-size=96 --experimental-strip-types scripts/memory-stress.mjs"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "semver": "7.8.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.2",
    "@deepseek-ai/schemastery": ">=3.19.0"
  }
}
